# Copy to .env on the VM (never commit real secrets)
CLINIC_NAME=HomeClinic
CLINIC_PHONE=9XXXXXXXXX
CLINIC_HOURS=9 AM – 8 PM

# Doctor phone for SMS + WhatsApp alerts (uncle)
CLINIC_NOTIFY_PHONE=+918143329173

POSTGRES_USER=homeclinic
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=homeclinic

ADMIN_EMAIL=admin@homeclinic.local
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=Clinic Admin
SECRET_KEY=change-me-to-a-long-random-string

# After you have a domain, add https://yourdomain.com
CORS_ORIGINS=http://localhost,http://127.0.0.1

# Optional email alerts
# CLINIC_NOTIFY_EMAIL=clinic@example.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# --- SMS (works now with Twilio SMS number) ---
# Create account at https://www.twilio.com → buy/get a number
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=+1XXXXXXXXXX

# --- WhatsApp (enable later — needs Twilio WhatsApp sandbox or Business API) ---
# Until you have WhatsApp Business / Twilio WhatsApp, leave this empty.
# Sandbox test: https://www.twilio.com/docs/whatsapp/sandbox
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
